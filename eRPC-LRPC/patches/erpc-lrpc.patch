--- a/src/transport_impl/fake/fake_transport.cc
+++ b/src/transport_impl/fake/fake_transport.cc
@@ -1,11 +1,80 @@
 #ifdef ERPC_FAKE
 #include "fake_transport.h"
+
 #include <cstdlib>
+#include <cstddef>
+#include <cstring>
+#include <stdexcept>
+
+#include "util/huge_alloc.h"
 
 namespace erpc {
 
 constexpr size_t FakeTransport::kMaxDataPerPkt;
 
-}  // namespace erpc
+FakeTransport::FakeTransport(uint16_t, uint8_t rpc_id, uint8_t phy_port,
+                             size_t numa_node, FILE *trace_file)
+    : Transport(TransportType::kFake, rpc_id, phy_port, numa_node, trace_file) {
+  reg_mr_func_ = [](void *, size_t) {
+    return mem_reg_info(nullptr, UINT32_MAX);
+  };
+  dereg_mr_func_ = [](mem_reg_info) {};
+  const char *role = std::getenv("ERPC_LRPC_ROLE");
+  caller_ = role != nullptr && std::strcmp(role, "caller") == 0;
+  if (caller_ && lrpc_bind(&lrpc_, "/dev/ub_lrpc0", 1, 1) != 0)
+    throw std::runtime_error("eRPC LRPC transport: bind failed");
+}
+
+FakeTransport::~FakeTransport() {
+  if (caller_) lrpc_close(&lrpc_);
+}
+
+void FakeTransport::init_hugepage_structures(HugeAlloc *huge_alloc,
+                                              uint8_t **rx_ring) {
+  huge_alloc_ = huge_alloc;
+  rx_ring_ = rx_ring;
+  Buffer extent = huge_alloc->alloc_raw(kNumRxRingEntries * kMTU,
+                                        DoRegister::kFalse);
+  if (extent.buf_ == nullptr)
+    throw std::runtime_error("eRPC LRPC transport: RX ring allocation failed");
+  for (size_t i = 0; i < kNumRxRingEntries; i++)
+    rx_ring_[i] = extent.buf_ + i * kMTU;
+}
 
+void FakeTransport::tx_burst(const tx_burst_item_t *items, size_t num_pkts) {
+  if (!caller_) return;
+  for (size_t i = 0; i < num_pkts; i++) {
+    const tx_burst_item_t &item = items[i];
+    if (item.pkt_idx_ != 0) continue;
+    const pkthdr_t *req = item.msg_buffer_->get_pkthdr_0();
+    if (!req->is_req() || req->msg_size_ > LRPC_PAYLOAD_MAX) continue;
+
+    lrpc_astack call;
+    std::memset(&call, 0, offsetof(lrpc_astack, payload));
+    call.abi = LRPC_ASTACK_ABI;
+    call.procedure_id = req->req_type_;
+    call.request_size = req->msg_size_;
+    std::memcpy(call.payload, item.msg_buffer_->buf_, req->msg_size_);
+    if (lrpc_invoke(&lrpc_, &call) != 0 || call.status != 0) continue;
+
+    uint8_t *dst = rx_ring_[rx_tail_];
+    auto *resp = reinterpret_cast<pkthdr_t *>(dst);
+    std::memcpy(resp, req, sizeof(*resp));
+    resp->msg_size_ = call.response_size;
+    resp->dest_session_num_ = 0;  // Validation client creates session zero.
+    resp->pkt_type_ = PktType::kResp;
+    resp->pkt_num_ = 0;
+    std::memcpy(dst + sizeof(*resp), call.payload, call.response_size);
+    rx_tail_ = (rx_tail_ + 1) % kNumRxRingEntries;
+    pending_++;
+  }
+}
+
+size_t FakeTransport::rx_burst() {
+  size_t ret = pending_;
+  pending_ = 0;
+  return ret;
+}
+
+}  // namespace erpc
 #endif
