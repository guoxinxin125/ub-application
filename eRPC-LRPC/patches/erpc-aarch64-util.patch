+  rt_assert(counter_frequency_hz != 0,
+            "Invalid AArch64 generic timer frequency");
+  // Existing conversion helpers expect timestamp-counter ticks per nanosecond.
+  return static_cast<double>(counter_frequency_hz) / 1e9;
